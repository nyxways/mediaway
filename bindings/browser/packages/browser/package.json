{
  "name": "@mediaway/browser",
  "version": "0.1.1",
  "description": "WASM fMP4 mux and demux for the browser — no native code, no install",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./pkg/iso_bmff_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "pkg"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyxways/mediaway.git"
  },
  "keywords": [
    "media",
    "mp4",
    "webcodecs",
    "wasm",
    "mediaway",
    "mux",
    "demux"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../../../../crates/iso-bmff-wasm --target web --out-dir pkg --release && bun ../../../../tools/scripts/optimize-wasm.ts pkg/iso_bmff_wasm_bg.wasm",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "prepack": "npm run build && node -e \"require('node:fs').rmSync('pkg/.gitignore',{force:true})\"",
    "test": "npm run build && npx tsx ../../examples/container/mux-roundtrip.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
