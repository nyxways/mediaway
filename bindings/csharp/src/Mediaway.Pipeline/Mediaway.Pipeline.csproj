<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is for Unity consumption (NuGetForUnity) — see docs/adr/0018-csharp-netstandard20-unity.md -->
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mediaway.Pipeline</RootNamespace>
    <AssemblyName>Mediaway.Pipeline</AssemblyName>
    <NeedsNativeRuntime>true</NeedsNativeRuntime>
    <Description>Rust-based, lightweight, fast idiomatic C# binding over mediaway-ffi (auto video encode -> fragmented MP4; AAC audio encode).</Description>
    <PackageTags>mediaway;video;audio;encode;h264;aac;mp4</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mediaway.Common\Mediaway.Common.csproj" />
    <!-- Capture-to-encode bridge (adr/pipeline/0005-capture-encode-bridge-c-abi.md) takes a
         raw CameraCaptureHandle/DesktopCaptureHandle — see the InternalsVisibleTo grants in
         each project's Interop/AssemblyInfo.cs. -->
    <ProjectReference Include="..\Mediaway.Device.Camera\Mediaway.Device.Camera.csproj" />
    <ProjectReference Include="..\Mediaway.Device.Desktop\Mediaway.Device.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="..\Mediaway.Common\Interop\NetStandardPolyfills.cs" Link="Interop\NetStandardPolyfills.cs" />
  </ItemGroup>

</Project>
