<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is for Unity consumption (NuGetForUnity) — see docs/adr/0018-csharp-netstandard20-unity.md -->
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mediaway.Pipeline</RootNamespace>
    <AssemblyName>Mediaway.Pipeline</AssemblyName>
    <NeedsNativeRuntime>true</NeedsNativeRuntime>
    <Description>Idiomatic C# binding over mediaway-ffi (auto video encode -> fragmented MP4).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mediaway.Common\Mediaway.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="..\Mediaway.Common\Interop\NetStandardPolyfills.cs" Link="Interop\NetStandardPolyfills.cs" />
  </ItemGroup>

</Project>
