<Project>
  <!--
    Mediaway native runtime: copy the bundled native lib matching this build
    into the consumer's output directory after build. The libs ship in this
    package under runtimes/<rid>/native (standard RID layout, one per
    platform this workspace ships a prebuilt lib for — see ADR-0024); this
    target makes them available for plain `dotnet run`/`dotnet build` too,
    where no RuntimeIdentifier exists to trigger NuGet's automatic RID
    resolution.

    RID selection: prefer an explicit $(RuntimeIdentifier) when the consumer
    set one (e.g. `dotnet publish -r osx-arm64`). Otherwise guess from the
    host OS via MSBuild's IsOSPlatform, defaulting to the x64 RID for that
    OS — a real, disclosed gap for a plain `dotnet run` on Apple Silicon with
    no RID set (pass `-r osx-arm64` or set RuntimeIdentifier explicitly to
    get the arm64 lib there instead of the x64 one under Rosetta).
  -->
  <PropertyGroup>
    <_MediawayRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MediawayRid>
    <_MediawayRid Condition="'$(_MediawayRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_MediawayRid>
    <_MediawayRid Condition="'$(_MediawayRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_MediawayRid>
    <_MediawayRid Condition="'$(_MediawayRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</_MediawayRid>
  </PropertyGroup>

  <Target Name="MediawayNativeCopy" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\$(_MediawayRid)\native')">
    <ItemGroup>
      <_MediawayNativeLib Include="$(MSBuildThisFileDirectory)..\runtimes\$(_MediawayRid)\native\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MediawayNativeLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
