<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mediaway.Container.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mediaway.Common\Mediaway.Common.csproj" />
    <ProjectReference Include="..\..\src\Mediaway.Container\Mediaway.Container.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native library for the P/Invoke layer. No real NuGet native-asset packaging exists
      yet (ADR-0017 build sequence step 5), so the library is copied in directly: prefer
      the release-staged copy under bindings/csharp/runtime/<rid>/native (populated by
      tools/scripts/copy-native-dlls.ts — what the release workflow's native-assets job
      stages and the RC-stage binding check downloads), and fall back to the workspace's
      dev-time cargo output so a local `dotnet test` still works without a staging step.
      `LibraryName = "mediaway_ffi"` in NativeMethods.cs has no extension, so .NET's own
      per-platform DllImport resolution picks whichever of these actually got copied —
      exactly one Exists() condition per platform holds, so exactly one file is copied.
    -->
    <None Include="..\..\runtime\win-x64\native\mediaway_ffi.dll"
          Condition="Exists('..\..\runtime\win-x64\native\mediaway_ffi.dll')"
          Link="mediaway_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\target\debug\mediaway_ffi.dll"
          Condition="!Exists('..\..\runtime\win-x64\native\mediaway_ffi.dll') AND Exists('..\..\..\..\target\debug\mediaway_ffi.dll')"
          Link="mediaway_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\linux-x64\native\libmediaway_ffi.so"
          Condition="Exists('..\..\runtime\linux-x64\native\libmediaway_ffi.so')"
          Link="libmediaway_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\target\debug\libmediaway_ffi.so"
          Condition="!Exists('..\..\runtime\linux-x64\native\libmediaway_ffi.so') AND Exists('..\..\..\..\target\debug\libmediaway_ffi.so')"
          Link="libmediaway_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      Explicit-target Linux build (cargo build with target x86_64-unknown-linux-gnu),
      needed when developing under WSL2 against a Windows-hosted checkout, where a
      plain cargo build on the Linux side would otherwise write into the SAME
      target/debug/ a Windows host build also uses, corrupting both. Real Linux
      hosts/CI never need this: their native cargo build already lands in
      target/debug/ above with no collision.
    -->
    <None Include="..\..\..\..\target\x86_64-unknown-linux-gnu\debug\libmediaway_ffi.so"
          Condition="!Exists('..\..\runtime\linux-x64\native\libmediaway_ffi.so') AND !Exists('..\..\..\..\target\debug\libmediaway_ffi.so') AND Exists('..\..\..\..\target\x86_64-unknown-linux-gnu\debug\libmediaway_ffi.so')"
          Link="libmediaway_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      macOS: two architectures can be staged side by side (native-assets-macos
      builds both x86_64 and arm64), so pick the one matching the actual host
      running this test process — RuntimeInformation.OSArchitecture, not a
      blind Exists() check, or both would match and collide on one Link name.
    -->
    <None Include="..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64' AND Exists('..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\osx-x64\native\libmediaway_ffi.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' != 'Arm64' AND Exists('..\..\runtime\osx-x64\native\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\target\debug\libmediaway_ffi.dylib"
          Condition="!Exists('..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib') AND !Exists('..\..\runtime\osx-x64\native\libmediaway_ffi.dylib') AND Exists('..\..\..\..\target\debug\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
