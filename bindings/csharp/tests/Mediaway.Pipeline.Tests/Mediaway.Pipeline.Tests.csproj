<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mediaway.Pipeline.Tests</RootNamespace>
    <!-- DecodeRoundtripTests.cs's test-local Opus-encode P/Invoke needs pointer arithmetic
         over pinned PCM (Mediaway.Pipeline.Interop.NativeMethods is internal to that
         assembly, so the test declares its own minimal raw bindings instead). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mediaway.Common\Mediaway.Common.csproj" />
    <ProjectReference Include="..\..\src\Mediaway.Container\Mediaway.Container.csproj" />
    <ProjectReference Include="..\..\src\Mediaway.Pipeline\Mediaway.Pipeline.csproj" />
    <!-- ScreenCaptureEncodeBridgeTests.cs exercises the real GPU device factory + Screen
         capture feeding EncodeSession.WriteFrameFromDesktopCapture. -->
    <ProjectReference Include="..\..\src\Mediaway.Device\Mediaway.Device.csproj" />
    <ProjectReference Include="..\..\src\Mediaway.Device.Desktop\Mediaway.Device.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native library for the P/Invoke layer. No real NuGet native-asset packaging exists
      yet (ADR-0017 build sequence step 5), so the DLL is copied in directly: prefer the
      release-staged copy under bindings/csharp/runtime/win-x64/native (populated by
      tools/scripts/copy-native-dlls.ts — what the release workflow's native-assets job
      stages and the RC-stage binding check downloads), and fall back to the workspace's
      dev-time cargo output so a local `dotnet test` still works without a staging step.
      Exactly one condition holds, so exactly one DLL is copied.
    -->
    <None Include="..\..\runtime\win-x64\native\mediaway_ffi.dll"
          Condition="Exists('..\..\runtime\win-x64\native\mediaway_ffi.dll')"
          Link="mediaway_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\target\debug\mediaway_ffi.dll"
          Condition="!Exists('..\..\runtime\win-x64\native\mediaway_ffi.dll') AND Exists('..\..\..\..\target\debug\mediaway_ffi.dll')"
          Link="mediaway_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      macOS: two architectures can be staged side by side (native-assets-macos
      builds both x86_64 and arm64), so pick the one matching the actual host
      running this test process — RuntimeInformation.OSArchitecture, not a
      blind Exists() check, or both would match and collide on one Link name.
    -->
    <None Include="..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64' AND Exists('..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\osx-x64\native\libmediaway_ffi.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' != 'Arm64' AND Exists('..\..\runtime\osx-x64\native\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\target\debug\libmediaway_ffi.dylib"
          Condition="!Exists('..\..\runtime\osx-arm64\native\libmediaway_ffi.dylib') AND !Exists('..\..\runtime\osx-x64\native\libmediaway_ffi.dylib') AND Exists('..\..\..\..\target\debug\libmediaway_ffi.dylib')"
          Link="libmediaway_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
