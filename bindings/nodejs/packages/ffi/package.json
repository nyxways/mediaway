{
  "name": "@mediaway/ffi",
  "version": "0.1.0",
  "description": "Internal koffi glue over Mediaway's C ABI (container/pipeline/device)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyxways/mediaway"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun ../../../../tools/scripts/copy-native-dlls.ts"
  },
  "dependencies": {
    "koffi": "^3.1.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
